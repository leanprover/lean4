diff --git a/include/mimalloc/prim-tls.h b/include/mimalloc/prim-tls.h
index 9e689e86..a157d192 100644
--- a/include/mimalloc/prim-tls.h
+++ b/include/mimalloc/prim-tls.h
@@ -308,7 +308,15 @@ static inline mi_theap_t* __mi_theap_empty(void) {
 
 #if MI_TLS_MODEL_LOCAL
 // Thread local with an initial value (default on Linux). Very efficient.
+#ifdef MI_THEAP_DEFAULT_TLS_FIELD
+// An embedding runtime hosts the default theap pointer inside its own thread-local struct so that
+// one TLS address computation serves both its own hot fields and the theap. It must declare, before
+// mimalloc's headers are seen, a thread-local whose `mi_theap_t*`-typed field this macro names as
+// an lvalue, and define that thread-local with `&_mi_theap_empty` as the field's initial value.
+#define __mi_theap_default  MI_THEAP_DEFAULT_TLS_FIELD
+#else
 extern mi_decl_hidden mi_decl_thread mi_theap_t* __mi_theap_default;  // default theap to allocate from
+#endif
 extern mi_decl_hidden mi_decl_thread mi_theap_t* __mi_theap_cached;   // theap from the last used heap
 
 // defined in `init.c`; do not use these directly
diff --git a/src/init.c b/src/init.c
index 37bf3583..4b9895c4 100644
--- a/src/init.c
+++ b/src/init.c
@@ -228,8 +228,10 @@ mi_threadid_t _mi_thread_id(void) mi_attr_noexcept {
 mi_decl_hidden mi_decl_thread void* __mi_thread_id_helper = NULL;
 
 #if MI_TLS_MODEL_LOCAL
+#ifndef MI_THEAP_DEFAULT_TLS_FIELD  // otherwise the embedding runtime defines the storage
 // the thread-local main theap for allocation
 mi_decl_hidden mi_decl_thread mi_theap_t* __mi_theap_default = (mi_theap_t*)&_mi_theap_empty;
+#endif
 // the last used non-main theap
 mi_decl_hidden mi_decl_thread mi_theap_t* __mi_theap_cached = (mi_theap_t*)&_mi_theap_empty;
 #endif

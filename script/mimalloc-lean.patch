 // main allocation primitives for small and generic allocation
 
 // internal small size allocation
@@ -204,6 +210,28 @@ mi_decl_nodiscard mi_decl_restrict void* mi_malloc_small(size_t size) mi_attr_no
   return mi_theap_malloc_small(_mi_theap_default(), size);
 }
 
+// Allocate a small block whose `size` is a positive multiple of the machine word size, so the
+// fast path can skip rounding the size to a bin index. For language runtimes with word-aligned
+// object sizes; otherwise behaves exactly like `mi_malloc_small`.
+mi_decl_nodiscard mi_decl_restrict void* mi_malloc_small_aligned(size_t size) mi_attr_noexcept {
+  mi_assert(size > 0 && (size % MI_INTPTR_SIZE) == 0 && size <= MI_SMALL_SIZE_MAX);
+  #if defined(__GNUC__) || defined(__clang__)
+  if ((size % MI_INTPTR_SIZE) != 0) { __builtin_unreachable(); }  // lets the bin indexing fold
+  #endif
+  #if MI_PADDING || MI_GUARDED
+  return mi_malloc_small(size);   // padded/guarded builds use the general small path
+  #else
+  mi_theap_t* const theap = _mi_theap_default();
+  #if MI_THEAP_INITASNULL
+  if mi_unlikely(theap == NULL) { return mi_malloc_small(size); }
+  #endif
+  mi_page_t* const page = _mi_theap_get_free_small_page_aligned(theap, size);
+  void* const p = mi_page_malloc_zero(theap, page, size, false, NULL);
+  mi_track_malloc(p, size, false);
+  return p;
+  #endif
+}
+
 mi_decl_nodiscard mi_decl_restrict void* mi_heap_malloc_small(mi_heap_t* heap, size_t size) mi_attr_noexcept {
   return mi_theap_malloc_small_zero_nonnull(_mi_heap_theap(heap), size, false, NULL);
 }

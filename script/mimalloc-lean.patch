+// As above, but `size` is already a multiple of `MI_INTPTR_SIZE` (see `mi_malloc_small_aligned`).
+static inline mi_page_t* _mi_theap_get_free_small_page_aligned(mi_theap_t* theap, size_t size) {
+  mi_assert_internal(size <= (MI_SMALL_SIZE_MAX + MI_PADDING_SIZE));
+  mi_assert_internal((size % MI_INTPTR_SIZE) == 0);
+  const size_t idx = size / MI_INTPTR_SIZE;
+  mi_assert_internal(idx < MI_PAGES_DIRECT);
+  return theap->pages_free_direct[idx];
+}

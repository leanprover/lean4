module

prelude
public import Init.Data.String.Basic
public import Init.Data.List.Nat.Basic

/-!
# Lemmas and definitions for the `String.simpEq` simproc.

This simproc exists for confluence of `append_assoc`, `append_singleton`, `push_eq_append`,
`push_empty`, `reduceSingleton`, `reducePush`, `reduceAppend` and `reduceOfList` with
`append_left_inj`, `append_right_inj`, `push_inj`, `singleton_append_inj`, `append_eq_left_iff` and
`append_eq_right_iff`.

In particular, the simproc can prove every lemma in this list (and any equality generated by the
simprocs). The four things this simproc can do are:

1. Proving trivial equalities (i.e. equalities by associativity). See `StringStructure.denote_eq`.
2. Proving trivial disequalities (i.e. disequalities in the form
`s ++ singleton c ++ t ≠ s' ++ singleton c' ++ t'` where `s.toList.length = s'.toList.length`
or `t.toList.length = t.toList.length` and `c ≠ c'`). See `StringStructure.denote_ne_left` and
`StringStructure.denote_ne_right`.
3. Reducing an equality of two strings with equal length to a conjunction of equalities on
characters. See `StringStructure.denote_char_inj`.
4. Cancelling strings from both sides (i.e. rewriting `s ++ t ++ u = s' ++ t' ++ u'` where
`s.toList.length = s'.toList.length` and `u.toList.length = u'.toList.length` to a conjunction
of `t = t'` and character equalities). See `StringStructure.denote_cancel`.
-/

@[expose] public section

namespace String.Internal.SimpEq

mutual

inductive StringStructure where
  | append (a b : StringStructure)
  | push (a : StringStructure) (c : Char)
  | singleton (c : Char)
  | ofList (l : ListStructure)
  | lit (l : List Char)
  | any (s : String)

inductive ListStructure where
  | nil
  | cons (c : Char) (l : ListStructure)
  | append (a b : ListStructure)
  | toList (l : StringStructure)
  | any (s : List Char)

end

/-- Represents a pair -/
inductive Cancellation where
  | nil
  | cons (l r : Char) (x : Cancellation)
  | string (s : String) (x : Cancellation)
  | list (l : List Char) (x : Cancellation)
  | char (c : Char) (x : Cancellation)

@[no_expose]
def stringAppendNoUnfold (s : String) : List Char → List Char :=
  s.toList.append

@[no_expose]
def listAppendNoUnfold (s : List Char) : List Char → List Char :=
  s.append

@[simp]
theorem stringAppendNoUnfold_eq (s : String) (l : List Char) :
    stringAppendNoUnfold s l = s.toList ++ l := (rfl)

@[simp]
theorem listAppendNoUnfold_eq (l₁ l₂ : List Char) :
    listAppendNoUnfold l₁ l₂ = l₁ ++ l₂ := (rfl)

noncomputable def fastAppend (l₁ l₂ : List Char) : List Char :=
  l₁.rec l₂ (fun x _ => List.cons x)

@[simp]
theorem fastAppend_eq_append : fastAppend = List.append := by
  funext a b
  induction a generalizing b <;> simp_all [fastAppend]

noncomputable def prependCond (p : Prop) : Option Prop → Option Prop :=
  Option.rec (some p) fun q => some (p ∧ q)

@[simp]
theorem prependCond_iff (p : Prop) (q : Option Prop) :
    (prependCond p q).getD True ↔ p ∧ q.getD True := by
  cases q <;> simp [prependCond]

noncomputable def Cancellation.evalLeft (c : Cancellation) (x : List Char) : List Char :=
  c.rec x -- nil
    (fun l _ _ => List.cons l) -- cons
    (fun s _ => stringAppendNoUnfold s) -- string
    (fun l _ => listAppendNoUnfold l) -- list
    (fun c _ => List.cons c) -- char

noncomputable def Cancellation.evalRight (c : Cancellation) (x : List Char) : List Char :=
  c.rec x -- nil
    (fun _ r _ => List.cons r) -- cons
    (fun s _ => stringAppendNoUnfold s) -- string
    (fun l _ => listAppendNoUnfold l) -- list
    (fun c _ => List.cons c) -- char

noncomputable def Cancellation.prependCancelConds
    (c : Cancellation) (x : Option Prop) : Option Prop :=
  c.rec x -- nil
    (fun l r _ => prependCond (l = r)) -- cons
    (fun _ _ ih => ih) -- string
    (fun _ _ ih => ih) -- list
    (fun _ _ ih => ih) -- char

theorem Cancellation.prependCancelConds_iff (c : Cancellation) (x y : List Char) (p : Option Prop)
    (hp : p.getD True ↔ x = y) :
    (c.prependCancelConds p).getD True ↔ c.evalLeft x = c.evalRight y := by
  induction c with simp_all [prependCancelConds, evalLeft, evalRight]

theorem Cancellation.prependCancelConds_false (c : Cancellation) :
    (c.prependCancelConds (some False)).getD True = False := by
  induction c with simp_all [prependCancelConds]

theorem Cancellation.length_evalLeft_eq_length_evalRight (c : Cancellation) (x : List Char) :
    (c.evalLeft x).length = (c.evalRight x).length := by
  induction c with simp_all [evalLeft, evalRight]

noncomputable def StringStructure.denote : StringStructure → String :=
  StringStructure.rec
    (fun _ _ ih ih' => ih ++ ih') -- append
    (fun _ c ih => ih.push c) -- push
    String.singleton -- singleton
    (fun _ => String.ofList) -- ofList
    String.ofList -- lit
    (fun s => s) -- any
    [] -- nil
    (fun c _ ih => c :: ih) -- cons
    (fun _ _ ih ih' => ih ++ ih') -- append
    (fun _ ih => ih.toList) -- toList
    (fun l => l) -- any

noncomputable def StringStructure.eval : StringStructure → List Char → List Char :=
  StringStructure.rec
    (fun _ _ ih ih' x => ih (ih' x)) -- append
    (fun _ c ih x => ih (c :: x)) -- push
    List.cons -- singleton
    (fun _ ih => ih) -- ofList
    fastAppend -- lit
    stringAppendNoUnfold -- any
    (fun x => x) -- nil
    (fun c _ ih x => c :: ih x) -- cons
    (fun _ _ ih ih' x => ih (ih' x)) -- append
    (fun _ ih => ih) -- toList
    listAppendNoUnfold -- any

noncomputable def ListStructure.denote : ListStructure → List Char :=
  ListStructure.rec (motive_1 := fun _ => String)
    (fun _ _ ih ih' => ih ++ ih') -- append
    (fun _ c ih => ih.push c) -- push
    String.singleton -- singleton
    (fun _ => String.ofList) -- ofList
    String.ofList -- lit
    (fun s => s) -- any
    [] -- nil
    (fun c _ ih => c :: ih) -- cons
    (fun _ _ ih ih' => ih ++ ih') -- append
    (fun _ ih => ih.toList) -- toList
    (fun l => l) -- any

noncomputable def ListStructure.eval : ListStructure → List Char → List Char :=
  ListStructure.rec
    (fun _ _ ih ih' x => ih (ih' x)) -- append
    (fun _ c ih x => ih (c :: x)) -- push
    List.cons -- singleton
    (fun _ ih => ih) -- ofList
    fastAppend -- lit
    stringAppendNoUnfold -- any
    (fun x => x) -- nil
    (fun c _ ih x => c :: ih x) -- cons
    (fun _ _ ih ih' x => ih (ih' x)) -- append4
    (fun _ ih => ih) -- toList
    listAppendNoUnfold -- any

@[simp]
theorem StringStructure.eval_eq_append_toList_denote (s : StringStructure) :
    s.eval = s.denote.toList.append := by
  induction s using StringStructure.rec (motive_2 := fun l => l.eval = l.denote.append) <;>
    simp_all [ListStructure.eval, ListStructure.denote, StringStructure.eval,
      StringStructure.denote, funext_iff]

theorem StringStructure.denote_eq (l l' : StringStructure)
    (h : l.eval [] = l'.eval [] := by eq_refl) :
    (l.denote = l'.denote) = True := by
  simpa [String.toList_inj] using h

theorem StringStructure.denote_ne_left (lhsStruct rhsStruct : StringStructure)
    (l l' : List Char) (lcancel : Cancellation) (c c' : Char) (hc : c.toNat.beq c'.toNat = false)
    (hlhs : lhsStruct.eval [] = lcancel.evalLeft (c :: l) := by eq_refl)
    (hrhs : rhsStruct.eval [] = lcancel.evalRight (c' :: l') := by eq_refl) :
    (lhsStruct.denote = rhsStruct.denote) = False := by
  simp only [eval_eq_append_toList_denote, List.append_eq, List.append_nil] at hlhs hrhs
  simp only [← toList_inj, hlhs, hrhs, eq_iff_iff, iff_false]
  simp only [Bool.eq_false_iff, ne_eq, Nat.beq_eq] at hc
  replace hc : c ≠ c' := ne_of_apply_ne _ hc
  rw [← Cancellation.prependCancelConds_iff _ _ _ (some False) (by simp [hc])]
  simp [Cancellation.prependCancelConds_false]

theorem StringStructure.denote_ne_right (lhsStruct rhsStruct lhsMid rhsMid : StringStructure)
    (rcancel : Cancellation) (c c' : Char) (hc : c.toNat.beq c'.toNat = false)
    (hlhs : lhsStruct.eval [] = lhsMid.eval (c :: rcancel.evalLeft []) := by eq_refl)
    (hrhs : rhsStruct.eval [] = rhsMid.eval (c' :: rcancel.evalRight []) := by eq_refl) :
    (lhsStruct.denote = rhsStruct.denote) = False := by
  simp only [eval_eq_append_toList_denote, List.append_eq, List.append_nil] at hlhs hrhs
  simp only [← toList_inj, hlhs, hrhs, eq_iff_iff, iff_false]
  simp only [Bool.eq_false_iff, ne_eq, Nat.beq_eq] at hc
  replace hc : c ≠ c' := ne_of_apply_ne _ hc
  rw [List.append_eq_append_iff_of_size_eq_right (by simp [rcancel.length_evalLeft_eq_length_evalRight])]
  simp [hc]

theorem StringStructure.denote_char_inj (lhsStruct rhsStruct : StringStructure)
    (lcancel : Cancellation)
    (hlhs : lhsStruct.eval [] = lcancel.evalLeft [])
    (hrhs : rhsStruct.eval [] = lcancel.evalRight []) :
    (lhsStruct.denote = rhsStruct.denote) = (lcancel.prependCancelConds none).getD True := by
  rw [Cancellation.prependCancelConds_iff _ [] [] _ (by simp)]
  simp [← hlhs, ← hrhs, String.toList_inj]

theorem StringStructure.denote_cancel (lhsStruct rhsStruct lhsMid rhsMid : StringStructure)
    (lcancel rcancel : Cancellation)
    (hlhs : lhsStruct.eval [] = lcancel.evalLeft (lhsMid.eval (rcancel.evalLeft [])))
    (hrhs : rhsStruct.eval [] = lcancel.evalRight (rhsMid.eval (rcancel.evalRight []))) :
    (lhsStruct.denote = rhsStruct.denote) =
      (lcancel.prependCancelConds (prependCond (lhsMid.denote = rhsMid.denote)
        (rcancel.prependCancelConds none))).getD True := by
  rw [Cancellation.prependCancelConds_iff _ (lhsMid.eval (rcancel.evalLeft []))
    (rhsMid.eval (rcancel.evalRight []))]
  · rw [← hlhs, ← hrhs]; simp [String.toList_inj]
  · rw [prependCond_iff, Cancellation.prependCancelConds_iff _ [] [] _ (by simp)]
    simp only [StringStructure.eval_eq_append_toList_denote, List.append_eq]
    rw [List.append_eq_append_iff_of_size_eq_right (rcancel.length_evalLeft_eq_length_evalRight [])]
    simp [String.toList_inj]

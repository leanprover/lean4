module

prelude

public import Lean.Kernel.InLean.Inductives.BlockTail
public import Lean.Kernel.InLean.Inductives.Basis
public import Lean.Kernel.InLean.IndGen

/-!
# InLean's inductive check: the declaration

An inductive declaration is generated by the unverified generator
(`Lean.Kernel.InLean.IndGen`, the official kernel's construction): the block's
constants as the official kernel adds them.  They are the stored block, and
con-leche's job decides whether they are accepted — twin of `checkIndDeclC`,
and `checkShapelessS` (`ConLeche.Cached.ParsedC`).
What InLean adds is the generated constants, exactly.

InLean reads an inductive's data at use (`Lean.Kernel.InLean.FEnv`), where con-leche
reads what its install computed; `genEntriesAgree` checks that the
generated entries carry what that install computes from the block.
-/

@[expose] public section

namespace Lean.Kernel.InLean

open Lean

/-- The generator's constants as a stored block: the formers, the
constructors, the recursors (the export's order). -/
def storedBlock (consts : Array ConstantInfo) : List ConstantInfo :=
  (consts.filter (·.isInductive) ++ consts.filter (·.isCtor) ++
    consts.filter fun | .recInfo _ => true | _ => false).toList

/-- A block constant: a former, a constructor or a recursor (what the
generator returns; `storedBlock` keeps exactly these). -/
def isBlockConst : ConstantInfo → Bool
  | .inductInfo _ | .ctorInfo _ | .recInfo _ => true
  | _ => false

/-- A generated constant's terms are in range (`EO.inRange`): the generator
is unverified, and the proof reads a term's cached fields. -/
def constInRange : ConstantInfo → Bool
  | .recInfo v => EO.inRange v.type && v.rules.all fun r => EO.inRange r.rhs
  | ci => EO.inRange ci.type

/-- A generated constant's terms are closed (no loose bound variable, read
off the cached range, which `constInRange` makes the term's): the
unverified generator's types and recursor rules are what the block check
opens. -/
def constClosed : ConstantInfo → Bool
  | .recInfo v => !v.type.hasLooseBVars && v.rules.all fun r => !r.rhs.hasLooseBVars
  | ci => !ci.type.hasLooseBVars

/-- A generated constant's terms carry no free variable and no metavariable
(the cached flags): the stored block is read as declaration terms. -/
def constGround : ConstantInfo → Bool
  | .recInfo v => !v.type.hasFVar && !v.type.hasMVar &&
      v.rules.all fun r => !r.rhs.hasFVar && !r.rhs.hasMVar
  | ci => !ci.type.hasFVar && !ci.type.hasMVar

/-- **The generated entries carry what con-leche's install computes** from
the block (`consBlockIndsF`, `consSumCtorsF`, `recEntry`): every former's
`all`, parameter and index counts, constructors and `isRec` (`blockIsRec`),
every constructor's type former and counts, every recursor's `all`. -/
def genEntriesAgree (p : BlockShape) (block : List ConstantInfo) : CheckCM Unit := do
  let isRec := blockIsRec p
  let names := p.memberNames
  for ms in p.members do
    match constNamed? block ms.cvT.name with
    | some (.inductInfo v) =>
      unless v.all == names && v.numParams == p.nP && v.numIndices == ms.nIdx &&
          v.ctors == ms.ctors.map (·.1.name) && v.isRec == isRec do
        throw (.internal s!"inductive generator: {ms.cvT.name}'s entry is not the block's")
    | _ => throw (.internal s!"inductive generator: no former {ms.cvT.name}")
    for (c, nF) in ms.ctors do
      match constNamed? block c.name with
      | some (.ctorInfo v) =>
        unless v.numParams == p.nP && v.numFields == nF && v.induct == ms.cvT.name do
          throw (.internal s!"inductive generator: {c.name}'s entry is not the block's")
      | _ => throw (.internal s!"inductive generator: no constructor {c.name}")
  for rc in p.recs do
    match constNamed? block rc.cvR.name with
    | some (.recInfo v) =>
      unless v.all == names do
        throw (.internal s!"inductive generator: {rc.cvR.name}'s entry is not the block's")
    | _ => throw (.internal s!"inductive generator: no recursor {rc.cvR.name}")

section
variable (mode : CheckMode)

/-- Twin of `checkShapelessS`. -/
def checkShapelessS (fe : FEnv) (block : List ConstantInfo) : CheckCM Unit := do
  block.foldlM (fun (_ : Unit) ci => match ci with
    | .inductInfo v => checkConstantValC mode fe v.name v.levelParams v.type
    | _ => pure ()) ()
  throw (.notImplemented s!"inductive block \
    {(block.head?.map (·.name)).getD .anonymous}: shape not recognised")

/-- Twin of `checkIndDeclC`: one route, the pinned basis blocks included. -/
def checkIndDeclC (fe : FEnv) (block : List ConstantInfo) (nP : Nat) : CheckCM Unit :=
  if indParamsOk nP block then
    match blockShape? nP block with
    | some p => do
      genEntriesAgree p block
      checkBlockKS mode fe block p
    | none => checkShapelessS mode fe block
  else throw (.invalid "number of parameters mismatch")

/-- An unsafe block, checked as the official kernel checks one: each
former's and constructor's type at the unsafe safety, in order (con-leche
has no unsafe declarations). -/
def checkUnsafeBlock (fe : FEnv) (consts : Array ConstantInfo) : CheckCM Unit := do
  let fe := { fe with safety := .unsafe }
  let _ ← consts.foldlM (fun (fe : FEnv) ci => do
    match ci with
    | .inductInfo _ | .ctorInfo _ => checkConstantValC mode fe ci.name ci.levelParams ci.type
    | _ => pure ()
    pure (fe.push ci)) fe

/-- **An inductive declaration**: generated (unverified, `Ind.genInductive`),
then checked (`checkIndDeclC`, after the `And` pin, `andPinOk`). -/
def checkInductiveC (fe : FEnv) (lps : List Name) (nparams : Nat) (types : List InductiveType)
    (isUnsafe : Bool) : CheckCM Added := do
  -- the generator runs in a state of its own
  let gen ← StateT.lift ((((Ind.genInductive mode lps nparams types isUnsafe).run
      { env := fe.env, coreAxioms := fe.coreAxioms }).run' {}).run' {})
  unless gen.consts.all isBlockConst do
    throw (.internal "inductive generator: a constant outside the block")
  unless gen.consts.all constInRange do
    throw (.internal "too many bound variables in a generated constant")
  unless gen.consts.all constClosed do
    throw (.internal "inductive generator: a constant with loose bound variables")
  unless gen.consts.all constGround do
    throw (.internal "inductive generator: a constant with free variables or metavariables")
  -- every name fresh in the environment itself, as official's `check_name`
  -- (the block check tests its own names; the generated recursors' and the
  -- auxiliary constants' are tested here)
  unless gen.consts.all (fun ci => (fe.env.find? ci.name).isNone) do
    let dup := gen.consts.find? (fun ci => (fe.env.find? ci.name).isSome)
    throw (.invalid s!"duplicate declaration {(dup.map (·.name)).getD .anonymous}")
  -- and distinct among themselves, as official's one-by-one additions
  unless namesNodup (gen.consts.toList.map (·.name)) do
    throw (.invalid "duplicate declaration in an inductive block")
  -- a safe block's constants are safe (the generator is not verified)
  unless isUnsafe || gen.consts.all safeConst do
    throw (.internal "inductive generator: an unsafe constant in a safe block")
  -- every projection body the extended environment reads is in range
  let feN : FEnv := { fe with env := gen.consts.foldl addConst fe.env }
  unless gen.consts.all fun ci => feN.projBodiesInRange ci.name do
    throw (.internal "too many bound variables in a projection body")
  -- and so is every intermediate term building them
  unless projStepsAllOk gen.consts do
    throw (.internal "too many bound variables in a projection body")
  -- the block check starts from the empty state
  set ({} : CState)
  if isUnsafe then
    checkUnsafeBlock mode fe gen.consts
    return gen
  let block := storedBlock gen.consts
  unless andPinOkBlock block nparams do
    throw (.invalid "`And` must be the standard `And`")
  checkIndDeclC mode fe block nparams
  return gen

end

end Lean.Kernel.InLean

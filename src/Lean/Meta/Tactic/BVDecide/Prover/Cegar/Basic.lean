module
prelude
public import Lean.Meta.Tactic.BVDecide.Prover.Basic
public import Lean.Meta.Tactic.BVDecide.TacticContext
public import Lean.Cadical.Basic

/-!
This module provides the basic infrastructure for the CEGAR (Counter Example Guided Abstraction Refinement)
solver.
-/

namespace Lean.Meta.Tactic.BVDecide

open Std.Tactic.BVDecide

/--
A hypothesis generated by the CEGAR refinement procedure.
-/
public structure CegarHyp where
  /--
  The `Expr`-level non-internalized hypothesis.
  -/
  hyp : Normalize.Hyp
  /--
  A `Syntax`-level regular tactic proof for the hypothesis.
  -/
  tacticProof : MetaM (TSyntax `Lean.Parser.Tactic.tacticSeq)
  /--
  A `Syntax`-level `grind` tactic proof for the hypothesis. If `none` we will use `have : hyp`
  and let `grind` modes' automation figure it out.
  -/
  grindProof : MetaM (Option (TSyntax `Lean.Parser.Tactic.tacticSeq))

namespace CegarM

public structure Context where
  /--
  The meta variable that the CEGAR procedure is operating on.
  -/
  goal : MVarId
  /--
  The set of unused hypothesis from the initial pre-processing, used for error messages later on.
  -/
  unusedHypotheses : Std.HashSet Normalize.Hyp
  /--
  The `bv_decide` general `TacticContext`.
  -/
  tacticContext : TacticContext

/--
State of the UF theory solver.
-/
public structure FunState where
  /--
  Cache for congruence lemmas on UF theory atoms.
  -/
  congrCache : Std.HashMap Sym.ExprPtr Expr := {}

/--
State of the BitVec theory solver.
-/
public structure BitVecState where
  /--
  The AIG built so far, incrementally extended every CEGAR step.
  -/
  aig : Std.Sat.AIG BVBit := .empty
  /--
  The bitblasting cached used so far, incrementally extended every CEGAR step.
  -/
  blastCache : BVExpr.Cache aig := .empty
  /--
  Both the CNF cache and CNF formula built up so far, incrementally extended every CEGAR step.
  -/
  cnfCache : Std.Sat.AIG.toCNF.State aig := .empty aig

/--
State carried around by our theory solvers.
-/
public structure TheoryState where
  /--
  UF theory state.
  -/
  funState : FunState := {}
  /--
  BitVec theory state.
  -/
  bitvecState : BitVecState := {}
  /--
  Caches for the hypothesis preprocessor.
  -/
  preprocessCaches : Grind.BVDecide.Caches := {}
  /--
  The incremental SAT solver.
  -/
  satSolver : Cadical.Solver

def TheoryState.new : BaseIO TheoryState := do
  return { satSolver := ← Cadical.Solver.new }

public structure State where
  /--
  The conjunction of all reflected expressions so far.
  -/
  satExpr : SatAtBVLogical
  /--
  The queue of facts that will be processed at the beginning of the next CEGAR round.
  -/
  hypQueue : Array CegarHyp := #[]
  /--
  The collection of hypotheses that have been used so far, used for proof recovery later on.
  -/
  usedHyps : Array CegarHyp := #[]
  /--
  Whether we should run another iteration of the procedure.
  -/
  didChange : Bool := true
  /--
  State for our various theory solvers.
  -/
  theoryState : TheoryState
  /--
  How many more milliseconds the SAT solver has to run.
  -/
  solverTimeBudgetMs : Nat
  /--
  How many more CEGAR rounds the solver has left.
  -/
  roundBudget : Nat

end CegarM

public abbrev CegarM (α : Type) := ReaderT CegarM.Context StateRefT CegarM.State LemmaM α

namespace CegarM

public def getReflectionResult : CegarM ReflectionResult := do
  return {
    satExpr := (← get).satExpr
    unusedHypotheses := (← read).unusedHypotheses
  }

@[inline]
public def getDidChange : CegarM Bool := return (← get).didChange

@[inline]
public def setDidChange (v : Bool) : CegarM Unit := modify fun s => { s with didChange := v }

@[inline]
public def getTheoryState : CegarM TheoryState := return (← get).theoryState

@[inline]
public def modifyTheoryState (f : TheoryState → TheoryState) : CegarM Unit :=
  modify fun s => { s with theoryState := f s.theoryState }

@[inline]
public def clearCaches : CegarM Unit := do
  modifyTheoryState fun s =>
    { s with
        funState := {},
        bitvecState := {},
        preprocessCaches := {}
    }

@[inline]
public def pushNewHyp (hyp : CegarHyp) : CegarM Unit :=
  modify fun s => { s with hypQueue := s.hypQueue.push hyp }

@[inline]
public def getUsedHyps : CegarM (Array CegarHyp) :=
  return (← get).usedHyps

@[inline]
public def drainNewHyps : CegarM (Array CegarHyp) :=
  modifyGet fun s => (s.hypQueue, { s with hypQueue := #[], usedHyps := s.usedHyps ++ s.hypQueue })

@[inline]
public def getTacticContext : CegarM TacticContext := return (← read).tacticContext

@[inline]
public def hasRefinementProcedures : CegarM Bool := do
  let cfg := (← getTacticContext).config
  return cfg.uf

@[inline]
public def consumeSolverTime (ms : Nat) : CegarM Unit := do
  modify fun s => { s with solverTimeBudgetMs := s.solverTimeBudgetMs - ms }

@[inline]
public def getSolverTime : CegarM Nat := do
  return (← get).solverTimeBudgetMs

@[inline]
public def consumeRound : CegarM Unit := do
  modify fun s => { s with roundBudget := s.roundBudget - 1 }

@[inline]
public def getRounds : CegarM Nat := do
  return (← get).roundBudget

@[inline]
public def takePreProcessCaches : CegarM Grind.BVDecide.Caches := do
  modifyGet fun s => (s.theoryState.preprocessCaches, { s with theoryState.preprocessCaches := {} })

@[inline]
public def setPreProcessCaches (caches : Grind.BVDecide.Caches) : CegarM Unit := do
  modify fun s => { s with theoryState.preprocessCaches := caches }

@[inline]
public def run (ctx : TacticContext) (x : CegarM (Except CounterExample α)) : UnsatProver α :=
  fun goal reflectionResult => do
    let state := {
      satExpr := reflectionResult.satExpr
      theoryState := ← TheoryState.new
      solverTimeBudgetMs := ctx.config.timeout * 1000
      roundBudget := ctx.config.cegarRounds
    }
    let ctx := {
      goal := goal
      unusedHypotheses := reflectionResult.unusedHypotheses
      tacticContext := ctx
    }
    StateRefT'.run' (ReaderT.run x ctx) state

public def getSatSolver : CegarM Cadical.Solver := return (← get).theoryState.satSolver

public structure CounterExample where
  exprCex : Std.HashMap Expr BVExpr.PackedBitVec
  atomCex : Std.HashMap Nat BVExpr.PackedBitVec

public def CounterExample.ofArray (arr : Array (Expr × Bool × BVExpr.PackedBitVec)) : ReifyM CounterExample := do
  let mut exprCex := {}
  let mut atomCex := Std.HashMap.emptyWithCapacity arr.size
  for (expr, _, val) in arr do
    let some atom ← ReifyM.getAtomNumber expr | unreachable!
    atomCex := atomCex.insert atom val
    exprCex := exprCex.insert expr val
  return { exprCex, atomCex }

end CegarM

public structure CegarCert where
  lemmas : Array CegarHyp
  lratCert : Option LratCert

namespace CegarCert

public def solvedWithPreProcessing : CegarCert := { lemmas := #[], lratCert := none }

public def ofLratCert (cert : LratCert) : CegarCert := { lemmas := #[], lratCert := some cert }

end CegarCert

public def CegarM.createCert (cert : Option LratCert) : CegarM CegarCert := do
  let lemmas ← getUsedHyps
  return {
    lemmas := lemmas
    lratCert := cert
  }

end Lean.Meta.Tactic.BVDecide

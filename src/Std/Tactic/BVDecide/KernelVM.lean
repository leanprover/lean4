/-!
# A bitblaster for `Lean.KernelVM`

`bvVMProg` bitblasts a `BVLogicalExpr` into an and-inverter graph (AIG), turns the AIG into a CNF
with the Tseitin encoding, and checks an LRAT proof that the CNF, together with the output of the
AIG, is unsatisfiable. With mode `1` (input 2) it stops after building the CNF, so that the tactic
can read the CNF from the memory, see `Lean.KernelVM.runMem` and `readCNF`.

The expression (input 0) is a sequence of 32-bit words: the number of nodes, the number of atoms,
and the nodes in an order where children come first, see `encodeBVLogical`. The proof (input 1) is
the largest clause id, followed by the steps as for `lratVMProg`.

Memory layout: words `0` to `3` are the number of CNF variables, the number of clauses, and the bases
of the clause starts and lengths (see `LRAT.KernelVM.loadCNF`). From word `8` on, the offset of the
literals of each node in the literal stream and its width. Then for each atom its literals' offset
(plus one, or `0` if not created yet) and width. Then, interleaved with stride 4 from base `B`: the
inputs of each AIG node, the literal stream, and the hash table for structural hashing. The AIG
literal of node `n` is `2 * n`, or `2 * n + 1` negated; node `0` is the constant `false`. The CNF
variable of AIG node `n` is `n`. Then the clause database of the LRAT checker.
-/

@[expose] public section

namespace Std.Tactic.BVDecide.KernelVM

open Lean.KernelVM Lean.KernelVM.DSL
open LRAT.KernelVM (W0 W1 loadCNF checkProof)

-- Registers (the LRAT checker uses registers below 30)
abbrev B := 100
abbrev numAig := 101
abbrev numLitsS := 102
abbrev cap := 103
abbrev mask := 104
abbrev cnt := 105
abbrev k := 106
abbrev pos := 107
abbrev kind := 108
abbrev wd := 109
abbrev off := 110
abbrev i := 111
abbrev j := 112
abbrev x := 113
abbrev y := 114
abbrev offA := 115
abbrev offB := 116
abbrev wA := 117
abbrev wB := 118
abbrev prm := 119
abbrev numNodes := 120
abbrev numAtoms := 121
abbrev atomT := 122
abbrev root := 123
abbrev mode := 124
abbrev z := 125
abbrev t1 := 126
abbrev t2 := 127
abbrev t3 := 128
abbrev t4 := 129
abbrev t5 := 130
abbrev cl := 131
abbrev l0 := 132
-- mkAnd
abbrev ra := 140
abbrev rb := 141
abbrev mt := 142
abbrev h := 143
abbrev e := 144
abbrev found := 145
abbrev nn := 146
abbrev gi := 147
abbrev gn := 148
-- mkXor, mkMux
abbrev xa := 150
abbrev xb := 151
abbrev xt1 := 152
abbrev xt2 := 153
abbrev mc := 154
abbrev mtt := 155
abbrev me := 156
abbrev mx1 := 157
abbrev mx2 := 158
-- addVec
abbrev ai := 160
abbrev ao := 161
abbrev carry := 162
abbrev a1 := 163
abbrev a2 := 164
abbrev a3 := 165
abbrev a4 := 166
abbrev a5 := 167
abbrev a6 := 168
-- mul, div, shifts, clz, cpop
abbrev mj := 170
abbrev accOff := 171
abbrev ppOff := 172
abbrev bj := 173
abbrev mi := 174
abbrev rOff := 175
abbrev qOff := 176
abbrev rsOff := 177
abbrev dOff := 178
abbrev bor := 179
abbrev qi := 180
abbrev s := 181
abbrev xOff := 182
abbrev bnz := 183
abbrev cv := 184
abbrev aL := 185
abbrev aR := 186
abbrev kc1 := 187
abbrev kc2 := 188
abbrev kci := 189
abbrev zOff := 190
abbrev eqOff := 191
abbrev ulA := 192
abbrev ulB := 193
abbrev negOff := 194
abbrev posQ := 195
abbrev negQ := 196
abbrev negR := 197
abbrev wn := 198
abbrev lay := 199
abbrev len := 200
abbrev it := 201
abbrev op1 := 202
abbrev op2 := 203
abbrev sp := 204
abbrev fr := 205
abbrev ph := 206
abbrev stackB := 207
abbrev cc := 208
abbrev ct := 209
abbrev cf := 210
abbrev nl := 211
abbrev nr := 212
abbrev ite := 213
abbrev ncMax := 214

/-- Marks AIG nodes that are not gates: the constant and the atoms. -/
abbrev MARK : Nat := 18446744073709551615

def leftA (n : Exp) : Exp := R B +ᵤ n *ᵤ K 4
def rightA (n : Exp) : Exp := R B +ᵤ n *ᵤ K 4 +ᵤ K 1
def litA (j : Exp) : Exp := R B +ᵤ j *ᵤ K 4 +ᵤ K 2
def slotA (t : Exp) : Exp := R B +ᵤ t *ᵤ K 4 +ᵤ K 3
def litAt (j : Exp) : Exp := Ld (litA j)
def nodeOffA (n : Exp) : Exp := K 8 +ᵤ n *ᵤ K 2
def nodeWA (n : Exp) : Exp := K 9 +ᵤ n *ᵤ K 2

/-- Appends `v` to the literal stream. -/
def pushLit (v : Exp) : Stmt :=
  seqs [.store (litA (R numLitsS)) v, .set numLitsS (R numLitsS +ᵤ K 1)]

/-- `for r in [0, lim)`. The limit is evaluated in each iteration. -/
def forI (r : Nat) (lim : Exp) (body : Stmt) : Stmt :=
  seqs [.set r (K 0), .while (R r <ᵤ lim) (seqs [body, .set r (R r +ᵤ K 1)])]

def hashOf (a b : Exp) : Stmt := seqs [
  .set mt ((a *ᵤ K 11400714819323198485) ^^ᵥ (b *ᵤ K 14029467366897019727)),
  .set h ((R mt ^^ᵥ (R mt >>>ᵥ K 31)) &&ᵥ R mask)]

/-- Doubles the hash table and inserts all gates again. -/
def grow : Stmt := seqs [
  .set cap (R cap *ᵤ K 2),
  .set mask (R cap -ᵤ K 1),
  forI gi (R cap) (.store (slotA (R gi)) (K 0)),
  .set gn (K 1),
  .while (R gn <ᵤ R numAig) (seqs [
    .ite (Ld (leftA (R gn)) ==ᵥ K MARK) .skip (seqs [
      hashOf (Ld (leftA (R gn))) (Ld (rightA (R gn))),
      .while (Not' (Ld (slotA (R h)) ==ᵥ K 0)) (.set h ((R h +ᵤ K 1) &&ᵥ R mask)),
      .store (slotA (R h)) (R gn)]),
    .set gn (R gn +ᵤ K 1)])]

/-- `r[d] := a ∧ b` for AIG literals, with constant folding and structural hashing. -/
def mkAnd (d : Nat) (a b : Exp) : Stmt := seqs [
  .set ra a, .set rb b,
  .ite (R rb <ᵤ R ra) (seqs [.set mt (R ra), .set ra (R rb), .set rb (R mt)]) .skip,
  .ite (R ra ==ᵥ K 0) (.set d (K 0)) <|
  .ite (R ra ==ᵥ K 1) (.set d (R rb)) <|
  .ite (R ra ==ᵥ R rb) (.set d (R ra)) <|
  .ite ((R ra ^^ᵥ K 1) ==ᵥ R rb) (.set d (K 0)) <|
  seqs [
    hashOf (R ra) (R rb),
    .set found (K 0),
    .while (Not' (R found)) (seqs [
      .set e (Ld (slotA (R h))),
      .ite (R e ==ᵥ K 0)
        (seqs [
          .set nn (R numAig),
          .store (leftA (R nn)) (R ra),
          .store (rightA (R nn)) (R rb),
          .store (slotA (R h)) (R nn),
          .set numAig (R numAig +ᵤ K 1),
          .set cnt (R cnt +ᵤ K 1),
          .set d (R nn *ᵤ K 2),
          .set found (K 1)])
        (.ite ((Ld (leftA (R e)) ==ᵥ R ra) &&ᵥ (Ld (rightA (R e)) ==ᵥ R rb))
          (seqs [.set d (R e *ᵤ K 2), .set found (K 1)])
          (.set h ((R h +ᵤ K 1) &&ᵥ R mask)))]),
    .ite (R cap <ᵤ R cnt *ᵤ K 2) grow .skip]]

def mkOr (d : Nat) (a b : Exp) : Stmt :=
  seqs [mkAnd d (a ^^ᵥ K 1) (b ^^ᵥ K 1), .set d (R d ^^ᵥ K 1)]

/-- `r[d] := a xor b`, as `¬(a ∧ b) ∧ ¬(¬a ∧ ¬b)` (`Std.Sat.AIG.mkXorCached`). -/
def mkXor (d : Nat) (a b : Exp) : Stmt := seqs [
  .set xa a, .set xb b,
  mkAnd xt1 (R xa) (R xb),
  mkAnd xt2 (R xa ^^ᵥ K 1) (R xb ^^ᵥ K 1),
  mkAnd d (R xt1 ^^ᵥ K 1) (R xt2 ^^ᵥ K 1)]

/-- `r[d] := a == b`, as `¬(a ∧ ¬b) ∧ ¬(¬a ∧ b)` (`Std.Sat.AIG.mkBEqCached`). -/
def mkBEq (d : Nat) (a b : Exp) : Stmt := seqs [
  .set xa a, .set xb b,
  mkAnd xt1 (R xa) (R xb ^^ᵥ K 1),
  mkAnd xt2 (R xa ^^ᵥ K 1) (R xb),
  mkAnd d (R xt1 ^^ᵥ K 1) (R xt2 ^^ᵥ K 1)]

/-- `r[d] := if c then t else e`. -/
def mkMux (d : Nat) (c t e : Exp) : Stmt := seqs [
  .set mc c, .set mtt t, .set me e,
  mkAnd mx1 (R mc) (R mtt),
  mkAnd mx2 (R mc ^^ᵥ K 1) (R me),
  mkOr d (R mx1) (R mx2)]

/-- `r[d] :=` the number of constant literals among the `wd` literals at offset `r[o]`. -/
def countKnown (d o : Nat) (wd : Exp) : Stmt := seqs [
  .set d (K 0),
  forI kci wd (.ite ((litAt (R o +ᵤ R kci) >>>ᵥ K 1) ==ᵥ K 0) (.set d (R d +ᵤ K 1)) .skip)]

/--
Appends the `wd` literals of the sum of the vectors at offsets `r[oa]` and `r[ob]`; `r[ao]` is its
offset. Like `Std.Tactic.BVDecide.BVExpr.bitblast.blastAdd`, the operand with fewer constant bits
comes first.
-/
def addVec (oa ob : Nat) (wd : Exp) : Stmt := seqs [
  countKnown kc1 oa wd,
  countKnown kc2 ob wd,
  .ite (R kc1 <ᵤ R kc2) (seqs [.set aL (R oa), .set aR (R ob)]) (seqs [.set aL (R ob), .set aR (R oa)]),
  .set ao (R numLitsS),
  .set carry (K 0),
  forI ai wd (seqs [
    .set a1 (litAt (R aL +ᵤ R ai)),
    .set a2 (litAt (R aR +ᵤ R ai)),
    mkXor a3 (R a1) (R a2),
    mkXor a4 (R a3) (R carry),
    pushLit (R a4),
    mkAnd a5 (R a3) (R carry),
    mkAnd a6 (R a1) (R a2),
    mkOr carry (R a5) (R a6)])]

/-- Appends the literals of `if r[c] then (vector at r[ot]) else (vector at r[oe])`; `r[d]` is its offset. -/
def iteVec (d c ot oe : Nat) (wd : Exp) : Stmt := seqs [
  .set z (R numLitsS),
  forI kci wd (seqs [mkMux t5 (R c) (litAt (R ot +ᵤ R kci)) (litAt (R oe +ᵤ R kci)), pushLit (R t5)]),
  .set d (R z)]

/-- `r[d] := a = b` for the vectors at offsets `r[oa]` and `r[ob]` (`Std.Tactic.BVDecide.BVPred.mkEq`). -/
def eqVec (d oa ob : Nat) (wd : Exp) : Stmt := seqs [
  .set eqOff (R numLitsS),
  forI kci wd (seqs [mkBEq t5 (litAt (R oa +ᵤ R kci)) (litAt (R ob +ᵤ R kci)), pushLit (R t5)]),
  .set d (K 1),
  forI kci wd (mkAnd d (R d) (litAt (R eqOff +ᵤ R kci)))]

/-- `r[d] := a < b` for the vectors at offsets `r[oa]` and `r[ob]` (`Std.Tactic.BVDecide.BVPred.mkUlt`). -/
def ultVec (d oa ob : Nat) (wd : Exp) : Stmt := seqs [
  .set ulA (R oa), .set ulB (R ob),
  .set d (K 1),
  forI kci wd (seqs [
    .set a1 (litAt (R ulA +ᵤ R kci)),
    .set a2 (litAt (R ulB +ᵤ R kci) ^^ᵥ K 1),
    mkXor a3 (R a1) (R a2),
    mkAnd a5 (R a3) (R d),
    mkAnd a6 (R a1) (R a2),
    mkOr d (R a5) (R a6)]),
  .set d (R d ^^ᵥ K 1)]

/-- Appends `wd` constant `false` literals; `r[d]` is their offset. -/
def zeros (d : Nat) (wd : Exp) : Stmt :=
  seqs [.set d (R numLitsS), forI kci wd (pushLit (K 0))]

/-- Reads child `r[x]` (from the word at `r[pos] + 1 + argIdx`) into `offA`/`wA` or `offB`/`wB`. -/
def child (dst : Nat) (word : Exp) (offR wR : Nat) : Stmt := seqs [
  .set dst word,
  .assert (R dst <ᵤ R k),
  .set offR (Ld (nodeOffA (R dst))),
  .set wR (Ld (nodeWA (R dst)))]

def arg (n : Nat) : Exp := W0 (R pos +ᵤ K n)

/-- `var w idx` -/
def doVar : Stmt := seqs [
  .set wd (arg 1), .set x (arg 2), .set pos (R pos +ᵤ K 3),
  .assert (R x <ᵤ R numAtoms),
  .set z (Ld (R atomT +ᵤ R x *ᵤ K 2)),
  .ite (R z ==ᵥ K 0)
    (seqs [
      .set off (R numLitsS),
      forI i (R wd) (seqs [
        .store (leftA (R numAig)) (K MARK),
        pushLit (R numAig *ᵤ K 2),
        .set numAig (R numAig +ᵤ K 1)]),
      .store (R atomT +ᵤ R x *ᵤ K 2) (R off +ᵤ K 1),
      .store (R atomT +ᵤ R x *ᵤ K 2 +ᵤ K 1) (R wd)])
    (seqs [
      .set off (R z -ᵤ K 1),
      .assert (Ld (R atomT +ᵤ R x *ᵤ K 2 +ᵤ K 1) ==ᵥ R wd)])]

/-- `const w bits…` -/
def doConst : Stmt := seqs [
  .set wd (arg 1), .set pos (R pos +ᵤ K 2),
  .set off (R numLitsS),
  forI i (R wd) (pushLit ((W0 (R pos +ᵤ (R i >>>ᵥ K 5)) >>>ᵥ (R i &&ᵥ K 31)) &&ᵥ K 1)),
  .set pos (R pos +ᵤ ((R wd +ᵤ K 31) >>>ᵥ K 5))]

/-- `extract start len x` -/
def doExtract : Stmt := seqs [
  .set prm (arg 1), .set wd (arg 2), child x (arg 3) offA wA, .set pos (R pos +ᵤ K 4),
  .set off (R numLitsS),
  forI i (R wd) (seqs [
    .set j (R prm +ᵤ R i),
    .ite (R j <ᵤ R wA) (pushLit (litAt (R offA +ᵤ R j))) (pushLit (K 0))])]

/-- Bitwise gate `g` (0 and, 1 or, 2 xor) on the children. -/
def bitwise (g : Nat) : Stmt := seqs [
  .set off (R numLitsS),
  forI i (R wd) (seqs [
    .set t1 (litAt (R offA +ᵤ R i)), .set t2 (litAt (R offB +ᵤ R i)),
    match g with
    | 0 => mkAnd t3 (R t1) (R t2)
    | 1 => mkOr t3 (R t1) (R t2)
    | _ => mkXor t3 (R t1) (R t2),
    pushLit (R t3)])]

/-- Multiplication, like `Std.Tactic.BVDecide.BVExpr.bitblast.blastMul`. -/
def doMul : Stmt := seqs [
  .ite (R wd ==ᵥ K 0) (.set off (R numLitsS)) (seqs [
    countKnown kc1 offA (R wd),
    countKnown kc2 offB (R wd),
    .ite (R kc1 <ᵤ R kc2) .skip (seqs [.set t1 (R offA), .set offA (R offB), .set offB (R t1)]),
    zeros zOff (R wd),
    .set bj (litAt (R offB)),
    iteVec accOff bj offA zOff (R wd),
    .set mj (K 1),
    .while (R mj <ᵤ R wd) (seqs [
      .set bj (litAt (R offB +ᵤ R mj)),
      .ite (R bj ==ᵥ K 0) .skip (seqs [
        .set ppOff (R numLitsS),
        forI mi (R wd) (.ite (R mi <ᵤ R mj) (pushLit (K 0)) (pushLit (litAt (R offA +ᵤ R mi -ᵤ R mj)))),
        addVec accOff ppOff (R wd),
        .set t1 (R ao),
        iteVec accOff bj t1 accOff (R wd)]),
      .set mj (R mj +ᵤ K 1)]),
    .set off (R accOff)])]

/-- Division and remainder, like `Std.Tactic.BVDecide.BVExpr.bitblast.blastUdiv` and `blastUmod`. -/
def doDiv (isDiv : Bool) : Stmt := seqs [
  zeros zOff (R wd),
  eqVec bnz offB zOff (R wd),
  .set qOff (R zOff), .set rOff (R zOff),
  .set wn (R wd),
  forI mj (R wd) (seqs [
    .set wn (R wn -ᵤ K 1),
    -- r' := [n[wn], r[0], …, r[w-2]]
    .set rsOff (R numLitsS),
    pushLit (litAt (R offA +ᵤ R wn)),
    forI t1 (R wd -ᵤ K 1) (pushLit (litAt (R rOff +ᵤ R t1))),
    .set posQ (R numLitsS),
    pushLit (K 0),
    forI t1 (R wd -ᵤ K 1) (pushLit (litAt (R qOff +ᵤ R t1))),
    .set negQ (R numLitsS),
    pushLit (K 1),
    forI t1 (R wd -ᵤ K 1) (pushLit (litAt (R qOff +ᵤ R t1))),
    -- negR := r' - d = r' + (¬d + 1)
    .set dOff (R numLitsS),
    forI t1 (R wd) (pushLit (litAt (R offB +ᵤ R t1) ^^ᵥ K 1)),
    .set t2 (R numLitsS),
    pushLit (K 1),
    forI t1 (R wd -ᵤ K 1) (pushLit (K 0)),
    addVec dOff t2 (R wd),
    .set negOff (R ao),
    addVec rsOff negOff (R wd),
    .set negR (R ao),
    ultVec qi rsOff offB (R wd),
    iteVec qOff qi posQ negQ (R wd),
    iteVec rOff qi rsOff negR (R wd)]),
  if isDiv then iteVec off bnz zOff qOff (R wd)
  else iteVec off bnz offA rOff (R wd)]

/-- `bin op x y` -/
def doBin : Stmt := seqs [
  .set prm (arg 1), child x (arg 2) offA wA, child y (arg 3) offB wB, .set pos (R pos +ᵤ K 4),
  .assert (R wA ==ᵥ R wB),
  .set wd (R wA),
  .ite (R prm ==ᵥ K 0) (bitwise 0) <|
  .ite (R prm ==ᵥ K 1) (bitwise 1) <|
  .ite (R prm ==ᵥ K 2) (bitwise 2) <|
  .ite (R prm ==ᵥ K 3) (seqs [addVec offA offB (R wd), .set off (R ao)]) <|
  .ite (R prm ==ᵥ K 4) doMul <|
  .ite (R prm ==ᵥ K 5) (doDiv true) <|
  seqs [.assert (R prm ==ᵥ K 6), doDiv false]]

/-- Appends the literals at `r[offA] + idx`, for `idx` computed from `i` by `f`. -/
def permute (idx : Exp) : Stmt := seqs [
  .set off (R numLitsS),
  forI i (R wd) (pushLit (litAt (R offA +ᵤ idx)))]

/-- Population count, like `Std.Tactic.BVDecide.BVExpr.bitblast.blastCpop`: a tree of additions. -/
def doCpop : Stmt :=
  .ite (K 1 <ᵤ R wd) (seqs [
    -- the bits, each zero-extended to `w` bits
    .set lay (R numLitsS),
    forI mj (R wd) (forI t1 (R wd) (.ite (R t1 ==ᵥ K 0) (pushLit (litAt (R offA +ᵤ R mj))) (pushLit (K 0)))),
    zeros zOff (R wd),
    .set len (R wd),
    .while (K 1 <ᵤ R len) (seqs [
      .set nl (R numLitsS),
      .set it (K 0),
      .while (R it *ᵤ K 2 <ᵤ R len) (seqs [
        .set op1 (R lay +ᵤ R it *ᵤ K 2 *ᵤ R wd),
        .ite (R it *ᵤ K 2 +ᵤ K 1 <ᵤ R len) (.set op2 (R op1 +ᵤ R wd)) (.set op2 (R zOff)),
        addVec op1 op2 (R wd),
        .set it (R it +ᵤ K 1)]),
      .set lay (R nl),
      .set len ((R len +ᵤ K 1) >>>ᵥ K 1)]),
    .set off (R lay)])
  (.ite (R wd ==ᵥ K 1) (.set off (R offA)) (.set off (R numLitsS)))

/-- `un op n x`: 0 not, 1 rotateLeft, 2 rotateRight, 3 arithShiftRightConst, 4 reverse, 5 clz, 6 cpop -/
def doUn : Stmt := seqs [
  .set prm (arg 1), .set z (arg 2), child x (arg 3) offA wA, .set pos (R pos +ᵤ K 4),
  .set wd (R wA),
  .ite (R prm ==ᵥ K 0) (seqs [.set off (R numLitsS), forI i (R wd) (pushLit (litAt (R offA +ᵤ R i) ^^ᵥ K 1))]) <|
  .ite (R prm ==ᵥ K 1) (permute (Exp.bin .umod ((R i +ᵤ R wd) -ᵤ Exp.bin .umod (R z) (R wd)) (R wd))) <|
  .ite (R prm ==ᵥ K 2) (permute (Exp.bin .umod (R i +ᵤ Exp.bin .umod (R z) (R wd)) (R wd))) <|
  .ite (R prm ==ᵥ K 3) (seqs [.set off (R numLitsS), forI i (R wd) (seqs [
      .set j (R i +ᵤ R z),
      .ite (R j <ᵤ R wd) (pushLit (litAt (R offA +ᵤ R j))) (pushLit (litAt (R offA +ᵤ R wd -ᵤ K 1)))])]) <|
  .ite (R prm ==ᵥ K 4) (permute (R wd -ᵤ K 1 -ᵤ R i)) <|
  .ite (R prm ==ᵥ K 5) (seqs [
      -- result := w; then for each bit i from the bottom: if a[i] then result := w - 1 - i
      .set rOff (R numLitsS),
      forI t1 (R wd) (.ite (R t1 <ᵤ K 64) (pushLit ((R wd >>>ᵥ R t1) &&ᵥ K 1)) (pushLit (K 0))),
      forI i (R wd) (seqs [
        .set cv (R wd -ᵤ K 1 -ᵤ R i),
        .set z (R numLitsS),
        forI t1 (R wd) (seqs [
          .ite (R t1 <ᵤ K 64) (.set t3 ((R cv >>>ᵥ R t1) &&ᵥ K 1)) (.set t3 (K 0)),
          mkMux t2 (litAt (R offA +ᵤ R i)) (R t3) (litAt (R rOff +ᵤ R t1)),
          pushLit (R t2)]),
        .set rOff (R z)]),
      .set off (R rOff)]) <|
  seqs [.assert (R prm ==ᵥ K 6), doCpop]]

/-- `append x y`, with `x` the high part -/
def doAppend : Stmt := seqs [
  child x (arg 1) offA wA, child y (arg 2) offB wB, .set pos (R pos +ᵤ K 3),
  .set wd (R wA +ᵤ R wB),
  .set off (R numLitsS),
  forI i (R wB) (pushLit (litAt (R offB +ᵤ R i))),
  forI i (R wA) (pushLit (litAt (R offA +ᵤ R i)))]

/-- `replicate n x` -/
def doReplicate : Stmt := seqs [
  .set prm (arg 1), child x (arg 2) offA wA, .set pos (R pos +ᵤ K 3),
  .set wd (R prm *ₛ R wA),
  .set off (R numLitsS),
  forI i (R wd) (pushLit (litAt (R offA +ᵤ Exp.bin .umod (R i) (R wA))))]

/-- Shifts by a variable amount: `kind` 0 left, 1 logical right, 2 arithmetic right. -/
def doShift (sk : Nat) : Stmt := seqs [
  child x (arg 1) offA wA, child y (arg 2) offB wB, .set pos (R pos +ᵤ K 3),
  .set wd (R wA),
  .set xOff (R offA),
  forI mj (R wB) (seqs [
    .set bj (litAt (R offB +ᵤ R mj)),
    .ite (R mj <ᵤ K 62) (.set s (K 1 <<<ᵥ R mj)) (.set s (K 4611686018427387904)),
    .set z (R numLitsS),
    forI i (R wd) (seqs [
      match sk with
      | 0 => .ite (R s ≤ᵤ R i) (.set t3 (litAt (R xOff +ᵤ R i -ᵤ R s))) (.set t3 (K 0))
      | 1 => .ite (R i +ᵤ R s <ᵤ R wd) (.set t3 (litAt (R xOff +ᵤ R i +ᵤ R s))) (.set t3 (K 0))
      | _ => .ite (R i +ᵤ R s <ᵤ R wd) (.set t3 (litAt (R xOff +ᵤ R i +ᵤ R s)))
          (.set t3 (litAt (R xOff +ᵤ R wd -ᵤ K 1))),
      mkMux t2 (R bj) (R t3) (litAt (R xOff +ᵤ R i)),
      pushLit (R t2)]),
    .set xOff (R z)]),
  .set off (R xOff)]

/-- Ends a Boolean node with the literal `r[t1]`. -/
def boolResult : Stmt := seqs [.set wd (K 1), .set off (R numLitsS), pushLit (R t1)]

/-- `eq x y` and `ult x y` -/
def doPred (isEq : Bool) : Stmt := seqs [
  child x (arg 1) offA wA, child y (arg 2) offB wB, .set pos (R pos +ᵤ K 3),
  .assert (R wA ==ᵥ R wB),
  if isEq then eqVec t1 offA offB (R wA) else ultVec t1 offA offB (R wA),
  boolResult]

/-- `getLsbD x idx` -/
def doGetLsb : Stmt := seqs [
  child x (arg 1) offA wA, .set prm (arg 2), .set pos (R pos +ᵤ K 3),
  .ite (R prm <ᵤ R wA) (.set t1 (litAt (R offA +ᵤ R prm))) (.set t1 (K 0)),
  boolResult]

/-- `gate g x y`: 0 and, 1 xor, 2 beq, 3 or -/
def doGate : Stmt := seqs [
  .set prm (arg 1), child x (arg 2) offA wA, child y (arg 3) offB wB, .set pos (R pos +ᵤ K 4),
  .set t2 (litAt (R offA)), .set t3 (litAt (R offB)),
  .ite (R prm ==ᵥ K 0) (mkAnd t1 (R t2) (R t3)) <|
  .ite (R prm ==ᵥ K 1) (mkXor t1 (R t2) (R t3)) <|
  .ite (R prm ==ᵥ K 2) (mkBEq t1 (R t2) (R t3)) <|
  seqs [.assert (R prm ==ᵥ K 3), mkOr t1 (R t2) (R t3)],
  boolResult]

/-- `ite c t e` -/
def doIte : Stmt := seqs [
  child x (arg 1) offA wA, child y (arg 2) offB wB, child z (arg 3) rOff t5, .set pos (R pos +ᵤ K 4),
  mkMux t1 (litAt (R offA)) (litAt (R offB)) (litAt (R rOff)),
  boolResult]

/-- Bitblasts all nodes. -/
def bitblast : Stmt := seqs [
  .set numNodes (W0 (K 0)),
  .set numAtoms (W0 (K 1)),
  .assert (R numNodes <ᵤ K 1073741824),
  .assert (R numAtoms <ᵤ K 1073741824),
  .set atomT (K 8 +ᵤ R numNodes *ᵤ K 2),
  .set B (R atomT +ᵤ R numAtoms *ᵤ K 2),
  .store (leftA (K 0)) (K MARK),
  .set numAig (K 1),
  .set cap (K 1024), .set mask (K 1023),
  .set pos (K 2),
  .set k (K 0),
  .while (R k <ᵤ R numNodes) (seqs [
    .set kind (arg 0),
    .ite (R kind ==ᵥ K 1) doVar <|
    .ite (R kind ==ᵥ K 2) doConst <|
    .ite (R kind ==ᵥ K 3) doExtract <|
    .ite (R kind ==ᵥ K 4) doBin <|
    .ite (R kind ==ᵥ K 5) doUn <|
    .ite (R kind ==ᵥ K 6) doAppend <|
    .ite (R kind ==ᵥ K 7) doReplicate <|
    .ite (R kind ==ᵥ K 8) (doShift 0) <|
    .ite (R kind ==ᵥ K 9) (doShift 1) <|
    .ite (R kind ==ᵥ K 10) (doShift 2) <|
    .ite (R kind ==ᵥ K 20) (doPred true) <|
    .ite (R kind ==ᵥ K 21) (doPred false) <|
    .ite (R kind ==ᵥ K 22) doGetLsb <|
    .ite (R kind ==ᵥ K 23) (seqs [.set t1 (arg 1), .assert (R t1 ≤ᵤ K 1), .set pos (R pos +ᵤ K 2), boolResult]) <|
    .ite (R kind ==ᵥ K 24) (seqs [child x (arg 1) offA wA, .set pos (R pos +ᵤ K 2),
      .set t1 (litAt (R offA) ^^ᵥ K 1), boolResult]) <|
    .ite (R kind ==ᵥ K 25) doGate <|
    seqs [.assert (R kind ==ᵥ K 26), doIte],
    .store (nodeOffA (R k)) (R off),
    .store (nodeWA (R k)) (R wd),
    .set k (R k +ᵤ K 1)]),
  .assert (K 0 <ᵤ R numNodes),
  .set root (litAt (Ld (nodeOffA (R numNodes -ᵤ K 1))))]

/-- Emits the clause with the literals `lits` (CNF literals, see `LRAT.KernelVM`). -/
def emitClause (lits : List Exp) : Stmt := seqs ([
  .store (R LRAT.KernelVM.startB +ᵤ R cl) (R LRAT.KernelVM.top),
  .store (R LRAT.KernelVM.lenB +ᵤ R cl) (K (lits.length + 1))] ++
  lits.map (fun l => seqs [.store (R LRAT.KernelVM.top) l, .set LRAT.KernelVM.top (R LRAT.KernelVM.top +ᵤ K 1)]) ++
  [.set cl (R cl +ᵤ K 1)])

/-- The CNF literal of AIG literal `a`, see `Std.Sat.AIG.toCNF`: `2 * (gate + 1)`, plus one if negated. -/
def cnfLit (a : Exp) : Exp := a +ᵤ K 2

/-- Pushes a DFS frame for the gate of AIG literal `a`. -/
def pushFrame (a : Exp) : Stmt := seqs [
  .set t5 (a >>>ᵥ K 1),
  .set fr (R stackB +ᵤ R sp *ᵤ K 5),
  .store (R fr) (R t5),
  .store (R fr +ᵤ K 1) (K 0),
  .set sp (R sp +ᵤ K 1)]

/--
Lays out the clause database and emits the CNF of the AIG like `Std.Sat.AIG.toCNF`: a depth-first
traversal from the root that emits the clauses of a node after those of its inputs, encoding
if-then-else structures directly (`Std.Sat.AIG.toCNF.detectIte`), and finally the root.
-/
def tseitin : Stmt := seqs [
  .set mode (In32 2 (K 0)),
  .set LRAT.KernelVM.nv (R numAig),
  -- at most four clauses per node, and the root
  .set ncMax (R numAig *ᵤ K 4 +ᵤ K 2),
  .set LRAT.KernelVM.maxId (R ncMax),
  .ite (R mode ==ᵥ K 0) (.ite (R LRAT.KernelVM.maxId <ᵤ W1 (K 0)) (.set LRAT.KernelVM.maxId (W1 (K 0))) .skip) .skip,
  .set LRAT.KernelVM.numLits (R LRAT.KernelVM.nv +ᵤ R LRAT.KernelVM.nv +ᵤ K 2),
  .set l0 (R numAig),
  .ite (R l0 <ᵤ R numLitsS) (.set l0 (R numLitsS)) .skip,
  .ite (R l0 <ᵤ R cap) (.set l0 (R cap)) .skip,
  .set stackB (R B +ᵤ R l0 *ᵤ K 4 +ᵤ K 4),
  .set LRAT.KernelVM.markB (R stackB +ᵤ R numAig *ᵤ K 5 +ᵤ K 8),
  .set LRAT.KernelVM.startB (R LRAT.KernelVM.markB +ᵤ R LRAT.KernelVM.numLits),
  .set LRAT.KernelVM.lenB (R LRAT.KernelVM.startB +ᵤ R LRAT.KernelVM.maxId +ᵤ K 1),
  .set LRAT.KernelVM.top (R LRAT.KernelVM.lenB +ᵤ R LRAT.KernelVM.maxId +ᵤ K 1),
  .set cl (K 1),
  -- the hash table slots become the visited marks
  forI gn (R numAig) (.store (slotA (R gn)) (K 0)),
  .set sp (K 0),
  pushFrame (R root),
  .while (R sp) (seqs [
    .set fr (R stackB +ᵤ (R sp -ᵤ K 1) *ᵤ K 5),
    .set nn (Ld (R fr)),
    .set ph (Ld (R fr +ᵤ K 1)),
    .ite (R ph ==ᵥ K 0)
      (.ite (Ld (slotA (R nn))) (.set sp (R sp -ᵤ K 1)) <|
       .ite (R nn ==ᵥ K 0) (seqs [emitClause [K 3], .store (slotA (R nn)) (K 1), .set sp (R sp -ᵤ K 1)]) <|
       .ite (Ld (leftA (R nn)) ==ᵥ K MARK) (seqs [.store (slotA (R nn)) (K 1), .set sp (R sp -ᵤ K 1)]) <|
       seqs [
        .set nl (Ld (leftA (R nn))),
        .set nr (Ld (rightA (R nn))),
        .set ite (K 0),
        .ite ((R nl &&ᵥ R nr &&ᵥ K 1) &&ᵥ Not' (Ld (leftA (R nl >>>ᵥ K 1)) ==ᵥ K MARK)
            &&ᵥ Not' (Ld (leftA (R nr >>>ᵥ K 1)) ==ᵥ K MARK)) (seqs [
          .set t1 (Ld (leftA (R nl >>>ᵥ K 1))), .set t2 (Ld (rightA (R nl >>>ᵥ K 1))),
          .set t3 (Ld (leftA (R nr >>>ᵥ K 1))), .set t4 (Ld (rightA (R nr >>>ᵥ K 1))),
          .set ite (K 1),
          .ite (R t1 ==ᵥ (R t3 ^^ᵥ K 1)) (seqs [.set cc (R t1), .set ct (R t2 ^^ᵥ K 1), .set cf (R t4 ^^ᵥ K 1)]) <|
          .ite (R t1 ==ᵥ (R t4 ^^ᵥ K 1)) (seqs [.set cc (R t1), .set ct (R t2 ^^ᵥ K 1), .set cf (R t3 ^^ᵥ K 1)]) <|
          .ite (R t2 ==ᵥ (R t3 ^^ᵥ K 1)) (seqs [.set cc (R t2), .set ct (R t1 ^^ᵥ K 1), .set cf (R t4 ^^ᵥ K 1)]) <|
          .ite (R t2 ==ᵥ (R t4 ^^ᵥ K 1)) (seqs [.set cc (R t2), .set ct (R t1 ^^ᵥ K 1), .set cf (R t3 ^^ᵥ K 1)]) <|
          .set ite (K 0)]) .skip,
        .ite (R ite)
          (seqs [.store (R fr +ᵤ K 1) (K 10), .store (R fr +ᵤ K 2) (R cc), .store (R fr +ᵤ K 3) (R ct),
            .store (R fr +ᵤ K 4) (R cf), pushFrame (R cc)])
          (seqs [.store (R fr +ᵤ K 1) (K 1), pushFrame (R nl)])]) <|
    .ite (R ph ==ᵥ K 1) (seqs [.store (R fr +ᵤ K 1) (K 2), pushFrame (Ld (rightA (R nn)))]) <|
    .ite (R ph ==ᵥ K 2) (seqs [
      .set t1 (R nn *ᵤ K 2 +ᵤ K 2),
      .set t2 (cnfLit (Ld (leftA (R nn)))),
      .set t3 (cnfLit (Ld (rightA (R nn)))),
      emitClause [R t1 ^^ᵥ K 1, R t2],
      emitClause [R t1 ^^ᵥ K 1, R t3],
      emitClause [R t1, R t2 ^^ᵥ K 1, R t3 ^^ᵥ K 1],
      .store (slotA (R nn)) (K 1),
      .set sp (R sp -ᵤ K 1)]) <|
    .ite (R ph ==ᵥ K 10) (seqs [.store (R fr +ᵤ K 1) (K 11), pushFrame (Ld (R fr +ᵤ K 3))]) <|
    .ite (R ph ==ᵥ K 11) (seqs [.store (R fr +ᵤ K 1) (K 12), pushFrame (Ld (R fr +ᵤ K 4))]) <|
    seqs [
      .set t1 (R nn *ᵤ K 2 +ᵤ K 2),
      .set t2 (cnfLit (Ld (R fr +ᵤ K 2))),
      .set t3 (cnfLit (Ld (R fr +ᵤ K 3))),
      .set t4 (cnfLit (Ld (R fr +ᵤ K 4))),
      emitClause [R t2 ^^ᵥ K 1, R t3 ^^ᵥ K 1, R t1],
      emitClause [R t2 ^^ᵥ K 1, R t3, R t1 ^^ᵥ K 1],
      emitClause [R t2, R t4 ^^ᵥ K 1, R t1],
      emitClause [R t2, R t4, R t1 ^^ᵥ K 1],
      .store (slotA (R nn)) (K 1),
      .set sp (R sp -ᵤ K 1)]]),
  emitClause [cnfLit (R root)],
  .set LRAT.KernelVM.nc (R cl -ᵤ K 1),
  .store (K 0) (R LRAT.KernelVM.nv), .store (K 1) (R LRAT.KernelVM.nc),
  .store (K 2) (R LRAT.KernelVM.startB), .store (K 3) (R LRAT.KernelVM.lenB)]

/-- The bitblaster and checker, see `bvVMProg`. -/
def bvVMStmt : Stmt := seqs [
  bitblast,
  tseitin,
  .ite (R mode ==ᵥ K 0) (checkProof 1) .skip]

/--
The bitblaster and checker: input 0 is the expression, input 1 the proof, input 2 the mode. This is
`bvVMStmt.compile`, which the test `kernelVMPrograms` checks.
-/
def bvVMProg : Nat := 

/-! ## Encoding -/

/-- The words encoding a `BitVec` constant. -/
def constWords {w : Nat} (v : BitVec w) : Array Nat :=
  (Array.range ((w + 31) / 32)).map fun i => (v.toNat >>> (32 * i)) % 4294967296

structure EncState where
  words : Array Nat := #[]
  numNodes : Nat := 0
  numAtoms : Nat := 0
  cache : Std.HashMap USize Nat := {}

abbrev EncM := StateM EncState

def EncM.node (ws : Array Nat) : EncM Nat :=
  modifyGet fun s => (s.numNodes, { s with words := s.words ++ ws, numNodes := s.numNodes + 1 })

unsafe def EncM.cached {α : Type} (a : α) (k : EncM Nat) : EncM Nat := do
  let addr := ptrAddrUnsafe a
  if let some n := (← get).cache[addr]? then return n
  let n ← k
  modify fun s => { s with cache := s.cache.insert addr n }
  return n

def binOpCode : BVBinOp → Nat
  | .and => 0 | .or => 1 | .xor => 2 | .add => 3 | .mul => 4 | .udiv => 5 | .umod => 6

def unOpCode : BVUnOp → Nat × Nat
  | .not => (0, 0) | .rotateLeft n => (1, n) | .rotateRight n => (2, n)
  | .arithShiftRightConst n => (3, n) | .reverse => (4, 0) | .clz => (5, 0) | .cpop => (6, 0)

unsafe def encodeExpr {w : Nat} (e : BVExpr w) : EncM Nat := EncM.cached e do
  match w, e with
  | w, .var idx => do
    modify fun s => { s with numAtoms := max s.numAtoms (idx + 1) }
    EncM.node #[1, w, idx]
  | w, .const v => EncM.node (#[2, w] ++ constWords v)
  | _, .extract start len x => do let a ← encodeExpr x; EncM.node #[3, start, len, a]
  | _, .bin x op y => do let a ← encodeExpr x; let b ← encodeExpr y; EncM.node #[4, binOpCode op, a, b]
  | _, .un op x => do
    let a ← encodeExpr x
    let (c, n) := unOpCode op
    EncM.node #[5, c, n, a]
  | _, .append x y _ => do let a ← encodeExpr x; let b ← encodeExpr y; EncM.node #[6, a, b]
  | _, .replicate n x _ => do let a ← encodeExpr x; EncM.node #[7, n, a]
  | _, .shiftLeft x y => do let a ← encodeExpr x; let b ← encodeExpr y; EncM.node #[8, a, b]
  | _, .shiftRight x y => do let a ← encodeExpr x; let b ← encodeExpr y; EncM.node #[9, a, b]
  | _, .arithShiftRight x y => do let a ← encodeExpr x; let b ← encodeExpr y; EncM.node #[10, a, b]

unsafe def encodePred (p : BVPred) : EncM Nat := EncM.cached p do
  match p with
  | .bin x .eq y => do let a ← encodeExpr x; let b ← encodeExpr y; EncM.node #[20, a, b]
  | .bin x .ult y => do let a ← encodeExpr x; let b ← encodeExpr y; EncM.node #[21, a, b]
  | .getLsbD x idx => do let a ← encodeExpr x; EncM.node #[22, a, idx]

def gateCode : Gate → Nat
  | .and => 0 | .xor => 1 | .beq => 2 | .or => 3

unsafe def encodeBool (e : BVLogicalExpr) : EncM Nat := EncM.cached e do
  match e with
  | .literal p => encodePred p
  | .const b => EncM.node #[23, if b then 1 else 0]
  | .not x => do let a ← encodeBool x; EncM.node #[24, a]
  | .gate g x y => do let a ← encodeBool x; let b ← encodeBool y; EncM.node #[25, gateCode g, a, b]
  | .ite c t e => do
    let a ← encodeBool c; let b ← encodeBool t; let d ← encodeBool e
    EncM.node #[26, a, b, d]

unsafe def encodeBVLogicalImpl (e : BVLogicalExpr) : Nat :=
  let ((), s) := (discard (encodeBool e)).run {}
  LRAT.KernelVM.words32ToNat (#[s.numNodes, s.numAtoms] ++ s.words)

/-- The encoding of `e` for `bvVMProg`. Shared subterms (by pointer) are encoded once. -/
@[implemented_by encodeBVLogicalImpl]
opaque encodeBVLogical (e : BVLogicalExpr) : Nat

/-- The encoding of a proof for `bvVMProg`, or `none` if it has RAT steps. -/
def encodeProof (proof : Array LRAT.IntAction) : Option Nat := do
  let words ← LRAT.KernelVM.encodeProofWords proof
  return LRAT.KernelVM.words32ToNat (#[LRAT.KernelVM.maxActionId proof] ++ words)

/-- Reads the CNF built by `bvVMProg` in mode `1` from its memory `mem`. -/
def readCNF (mem : ByteArray) : Std.Sat.CNF Nat :=
  let word (a : Nat) : Nat :=
    (List.range 8).foldl (init := 0) fun r b => r + (mem.get! (8 * a + b)).toNat <<< (8 * b)
  let nc := word 1
  let startB := word 2
  let lenB := word 3
  let clauses := (List.range nc).foldl (init := Array.emptyWithCapacity nc) fun cls c =>
    let st := word (startB + c + 1)
    let len := word (lenB + c + 1) - 1
    let lits := (List.range len).map fun t =>
      let l := word (st + t)
      (l / 2 - 1, l % 2 == 0)
    cls.push (Std.Sat.CNF.Clause.ofLiterals lits)
  ⟨clauses⟩

end Std.Tactic.BVDecide.KernelVM

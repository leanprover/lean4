def mkWide128 (n : Nat) : Wide128 := { (default : Wide128) with f0 := n, f127 := n + 1 }
def mkWide255 (n : Nat) : Wide255 := { (default : Wide255) with f0 := n, f254 := n + 2 }

def main : IO Unit := do
  let xs := (List.range 500).map mkWide128
  let ys := (List.range 500).map mkWide255
  IO.println (xs.foldl (fun a w => a + w.f0 + w.f127) 0)
  IO.println (ys.foldl (fun a w => a + w.f0 + w.f254) 0)

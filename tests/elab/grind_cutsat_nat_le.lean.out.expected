[grind.debug.proof] Lean.Grind.intro_with_eq (x < y + z) (x + 1 ≤ y + z) (y + 1 < z → z + x < 3 * z)
      (Lean.Grind.Nat.lt_eq x (y + z)) fun h =>
      Lean.Grind.intro_with_eq (y + 1 < z) (y + 2 ≤ z) (z + x < 3 * z)
        (Eq.trans (Lean.Grind.Nat.lt_eq (y + 1) z)
          (id
            (Nat.Internal.Linear.ExprCnstr.eq_of_toNormPoly_eq_k
              (Lean.RArray.branch 1 (Lean.RArray.leaf y) (Lean.RArray.leaf z))
              { eq := false,
                lhs :=
                  ((Nat.Internal.Linear.Expr.var 0).add (Nat.Internal.Linear.Expr.num 1)).add
                    (Nat.Internal.Linear.Expr.num 1),
                rhs := Nat.Internal.Linear.Expr.var 1 }
              { eq := false, lhs := (Nat.Internal.Linear.Expr.var 0).add (Nat.Internal.Linear.Expr.num 2),
                rhs := Nat.Internal.Linear.Expr.var 1 }
              (eagerReduce (Eq.refl true)))))
        fun h_1 =>
        Eq.mpr
          (id
            (Eq.trans (Lean.Grind.Nat.lt_eq (z + x) (3 * z))
              (id
                (Nat.Internal.Linear.ExprCnstr.eq_of_toNormPoly_eq_k
                  (Lean.RArray.branch 1 (Lean.RArray.leaf x) (Lean.RArray.leaf z))
                  { eq := false,
                    lhs :=
                      ((Nat.Internal.Linear.Expr.var 1).add (Nat.Internal.Linear.Expr.var 0)).add
                        (Nat.Internal.Linear.Expr.num 1),
                    rhs := Nat.Internal.Linear.Expr.mulL 3 (Nat.Internal.Linear.Expr.var 1) }
                  { eq := false, lhs := (Nat.Internal.Linear.Expr.var 0).add (Nat.Internal.Linear.Expr.num 1),
                    rhs := Nat.Internal.Linear.Expr.mulL 2 (Nat.Internal.Linear.Expr.var 1) }
                  (eagerReduce (Eq.refl true))))))
          (Classical.byContradiction
            (Lean.Grind.intro_with_eq (¬x + 1 ≤ 2 * z) (2 * z ≤ x) False
              (Eq.trans (Nat.not_le_eq (x + 1) (2 * z))
                (Nat.Simproc.add_le_add_le (2 * z) x (of_decide_eq_true (Eq.refl true))))
              fun h_2 =>
              id
                (let ctx :=
                  Lean.RArray.branch 1 (Lean.RArray.leaf ↑x)
                    (Lean.RArray.branch 2 (Lean.RArray.leaf ↑y) (Lean.RArray.leaf ↑z));
                le_unsat ctx (Poly.num 12) (eagerReduce (Eq.refl true))
                  (le_combine_rfl ctx (Poly.add (-2) 1 (Poly.add 1 0 (Poly.num 2)))
                    (Poly.add 2 1 (Poly.add (-1) 0 (Poly.num 4))) (Poly.num 12) (Eq.refl (Poly.num 12))
                    (le_combine_rfl ctx (Poly.add (-1) 2 (Poly.add (-1) 1 (Poly.add 1 0 (Poly.num 1))))
                      (Poly.add 2 2 (Poly.add (-1) 0 (Poly.num 0))) (Poly.add (-2) 1 (Poly.add 1 0 (Poly.num 2)))
                      (Eq.refl (Poly.add (-2) 1 (Poly.add 1 0 (Poly.num 2))))
                      (le_norm_expr_rfl ctx ((Expr.var 0).add (Expr.num 1)) ((Expr.var 1).add (Expr.var 2))
                        (Poly.add (-1) 2 (Poly.add (-1) 1 (Poly.add 1 0 (Poly.num 1))))
                        (Eq.refl (Poly.add (-1) 2 (Poly.add (-1) 1 (Poly.add 1 0 (Poly.num 1)))))
                        (Nat.ToInt.of_le (Nat.ToInt.add_congr (Eq.refl ↑x) (Nat.ToInt.natCast_ofNat 1))
                          (Nat.ToInt.add_congr (Eq.refl ↑y) (Eq.refl ↑z)) h))
                      (le_norm_expr_rfl ctx (Expr.mulL 2 (Expr.var 2)) (Expr.var 0)
                        (Poly.add 2 2 (Poly.add (-1) 0 (Poly.num 0)))
                        (Eq.refl (Poly.add 2 2 (Poly.add (-1) 0 (Poly.num 0))))
                        (Nat.ToInt.of_le (Nat.ToInt.mul_congr (Nat.ToInt.natCast_ofNat 2) (Eq.refl ↑z)) (Eq.refl ↑x)
                          h_2)))
                    (le_combine_rfl ctx (Poly.add (-1) 2 (Poly.add 1 1 (Poly.num 2)))
                      (Poly.add 2 2 (Poly.add (-1) 0 (Poly.num 0))) (Poly.add 2 1 (Poly.add (-1) 0 (Poly.num 4)))
                      (Eq.refl (Poly.add 2 1 (Poly.add (-1) 0 (Poly.num 4))))
                      (le_norm_expr_rfl ctx ((Expr.var 1).add (Expr.num 2)) (Expr.var 2)
                        (Poly.add (-1) 2 (Poly.add 1 1 (Poly.num 2)))
                        (Eq.refl (Poly.add (-1) 2 (Poly.add 1 1 (Poly.num 2))))
                        (Nat.ToInt.of_le (Nat.ToInt.add_congr (Eq.refl ↑y) (Nat.ToInt.natCast_ofNat 2)) (Eq.refl ↑z)
                          h_1))
                      (le_norm_expr_rfl ctx (Expr.mulL 2 (Expr.var 2)) (Expr.var 0)
                        (Poly.add 2 2 (Poly.add (-1) 0 (Poly.num 0)))
                        (Eq.refl (Poly.add 2 2 (Poly.add (-1) 0 (Poly.num 0))))
                        (Nat.ToInt.of_le (Nat.ToInt.mul_congr (Nat.ToInt.natCast_ofNat 2) (Eq.refl ↑z)) (Eq.refl ↑x)
                          h_2)))))))
private theorem ex1 : ∀ (x y z : Nat), x < y + z → y + 1 < z → z + x < 3 * z :=
fun x y z => ex1._proof_1_1 x y z
private theorem ex2 : ∀ {p : Prop} (x y z : Nat), x < y + z → y + 1 < z → (p ↔ z + x < 3 * z) → p :=
fun {p} x y z => ex2._proof_1_1 x y z
private theorem ex3 : ∀ (x y : Nat),
  27 ≤ 13 * x + 11 * y → 13 * x + 11 * y ≤ 30 → 7 * y ≤ 9 * x + 10 → 9 * x ≤ 4 + 7 * y → False :=
fun x y => ex3._proof_1_1 x y

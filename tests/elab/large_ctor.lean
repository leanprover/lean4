import Lean.Compiler.LCNF.Basic

/-!
Tests the limits on the number of object fields and on the size of the scalar fields of a
constructor. See `tests/compile/ctor_many_fields.lean` for constructors with many object fields
below the limit.
-/

open Lean Compiler LCNF

#guard_msgs in
run_meta
  ({ name := `Foo.mk, cidx := 0, size := maxCtorFields - 1, usize := 0, ssize := 0 } : CtorInfo).checkValid

/-- error: constructor 'Foo.mk' has too many fields -/
#guard_msgs in
run_meta
  ({ name := `Foo.mk, cidx := 0, size := maxCtorFields, usize := 0, ssize := 0 } : CtorInfo).checkValid

-- the largest constructor must still fit the 16-bit object size field
#guard 8 + 8 * maxCtorFields + maxCtorScalarsSize < 2 ^ 16

/-- error: constructor 'Bar.mk' has too many scalar fields -/

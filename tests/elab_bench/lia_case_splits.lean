/-!
Benchmark for `lia` on goals that need many `grind` case splits. A cutsat constraint stored in the
goal of a case split is proved once in that goal and shared by all subgoals below it, instead of
being proved again in every branch.
* `disj_all_n`: `n` disjunctions `x_i = 0 ∨ x_i = 1`, `2^n` branches.
* `ite_n`: a chain of `n` `if-then-else` definitions.
* `minmax_n`: nested `max` of `n` variables.
* `natsub_n`: a sum of `n` truncated `Nat` subtractions.
-/
set_option maxHeartbeats 0

theorem disj_all_8 (x0 : Int) (x1 : Int) (x2 : Int) (x3 : Int) (x4 : Int) (x5 : Int) (x6 : Int) (x7 : Int) (h0 : x0 = 0 ∨ x0 = 1) (h1 : x1 = 0 ∨ x1 = 1) (h2 : x2 = 0 ∨ x2 = 1) (h3 : x3 = 0 ∨ x3 = 1) (h4 : x4 = 0 ∨ x4 = 1) (h5 : x5 = 0 ∨ x5 = 1) (h6 : x6 = 0 ∨ x6 = 1) (h7 : x7 = 0 ∨ x7 = 1) : x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7 ≤ 8 := by lia (splits := 100000)

theorem disj_all_12 (x0 : Int) (x1 : Int) (x2 : Int) (x3 : Int) (x4 : Int) (x5 : Int) (x6 : Int) (x7 : Int) (x8 : Int) (x9 : Int) (x10 : Int) (x11 : Int) (h0 : x0 = 0 ∨ x0 = 1) (h1 : x1 = 0 ∨ x1 = 1) (h2 : x2 = 0 ∨ x2 = 1) (h3 : x3 = 0 ∨ x3 = 1) (h4 : x4 = 0 ∨ x4 = 1) (h5 : x5 = 0 ∨ x5 = 1) (h6 : x6 = 0 ∨ x6 = 1) (h7 : x7 = 0 ∨ x7 = 1) (h8 : x8 = 0 ∨ x8 = 1) (h9 : x9 = 0 ∨ x9 = 1) (h10 : x10 = 0 ∨ x10 = 1) (h11 : x11 = 0 ∨ x11 = 1) : x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + x10 + x11 ≤ 12 := by lia (splits := 100000)

theorem ite_16 (y0 : Int) (y1 : Int) (y2 : Int) (y3 : Int) (y4 : Int) (y5 : Int) (y6 : Int) (y7 : Int) (y8 : Int) (y9 : Int) (y10 : Int) (y11 : Int) (y12 : Int) (y13 : Int) (y14 : Int) (y15 : Int) (y16 : Int) (h0 : y0 = 0) (h1 : y1 = if y0 < 1000 then y0 + 1 else y0) (h2 : y2 = if y1 < 1000 then y1 + 1 else y1) (h3 : y3 = if y2 < 1000 then y2 + 1 else y2) (h4 : y4 = if y3 < 1000 then y3 + 1 else y3) (h5 : y5 = if y4 < 1000 then y4 + 1 else y4) (h6 : y6 = if y5 < 1000 then y5 + 1 else y5) (h7 : y7 = if y6 < 1000 then y6 + 1 else y6) (h8 : y8 = if y7 < 1000 then y7 + 1 else y7) (h9 : y9 = if y8 < 1000 then y8 + 1 else y8) (h10 : y10 = if y9 < 1000 then y9 + 1 else y9) (h11 : y11 = if y10 < 1000 then y10 + 1 else y10) (h12 : y12 = if y11 < 1000 then y11 + 1 else y11) (h13 : y13 = if y12 < 1000 then y12 + 1 else y12) (h14 : y14 = if y13 < 1000 then y13 + 1 else y13) (h15 : y15 = if y14 < 1000 then y14 + 1 else y14) (h16 : y16 = if y15 < 1000 then y15 + 1 else y15) : y16 ≤ 16 := by lia (splits := 100000)

theorem ite_32 (y0 : Int) (y1 : Int) (y2 : Int) (y3 : Int) (y4 : Int) (y5 : Int) (y6 : Int) (y7 : Int) (y8 : Int) (y9 : Int) (y10 : Int) (y11 : Int) (y12 : Int) (y13 : Int) (y14 : Int) (y15 : Int) (y16 : Int) (y17 : Int) (y18 : Int) (y19 : Int) (y20 : Int) (y21 : Int) (y22 : Int) (y23 : Int) (y24 : Int) (y25 : Int) (y26 : Int) (y27 : Int) (y28 : Int) (y29 : Int) (y30 : Int) (y31 : Int) (y32 : Int) (h0 : y0 = 0) (h1 : y1 = if y0 < 1000 then y0 + 1 else y0) (h2 : y2 = if y1 < 1000 then y1 + 1 else y1) (h3 : y3 = if y2 < 1000 then y2 + 1 else y2) (h4 : y4 = if y3 < 1000 then y3 + 1 else y3) (h5 : y5 = if y4 < 1000 then y4 + 1 else y4) (h6 : y6 = if y5 < 1000 then y5 + 1 else y5) (h7 : y7 = if y6 < 1000 then y6 + 1 else y6) (h8 : y8 = if y7 < 1000 then y7 + 1 else y7) (h9 : y9 = if y8 < 1000 then y8 + 1 else y8) (h10 : y10 = if y9 < 1000 then y9 + 1 else y9) (h11 : y11 = if y10 < 1000 then y10 + 1 else y10) (h12 : y12 = if y11 < 1000 then y11 + 1 else y11) (h13 : y13 = if y12 < 1000 then y12 + 1 else y12) (h14 : y14 = if y13 < 1000 then y13 + 1 else y13) (h15 : y15 = if y14 < 1000 then y14 + 1 else y14) (h16 : y16 = if y15 < 1000 then y15 + 1 else y15) (h17 : y17 = if y16 < 1000 then y16 + 1 else y16) (h18 : y18 = if y17 < 1000 then y17 + 1 else y17) (h19 : y19 = if y18 < 1000 then y18 + 1 else y18) (h20 : y20 = if y19 < 1000 then y19 + 1 else y19) (h21 : y21 = if y20 < 1000 then y20 + 1 else y20) (h22 : y22 = if y21 < 1000 then y21 + 1 else y21) (h23 : y23 = if y22 < 1000 then y22 + 1 else y22) (h24 : y24 = if y23 < 1000 then y23 + 1 else y23) (h25 : y25 = if y24 < 1000 then y24 + 1 else y24) (h26 : y26 = if y25 < 1000 then y25 + 1 else y25) (h27 : y27 = if y26 < 1000 then y26 + 1 else y26) (h28 : y28 = if y27 < 1000 then y27 + 1 else y27) (h29 : y29 = if y28 < 1000 then y28 + 1 else y28) (h30 : y30 = if y29 < 1000 then y29 + 1 else y29) (h31 : y31 = if y30 < 1000 then y30 + 1 else y30) (h32 : y32 = if y31 < 1000 then y31 + 1 else y31) : y32 ≤ 32 := by lia (splits := 100000)

theorem minmax_8 (x0 : Int) (x1 : Int) (x2 : Int) (x3 : Int) (x4 : Int) (x5 : Int) (x6 : Int) (x7 : Int) (m : Int) (h0 : m = max x0 (max x1 (max x2 (max x3 (max x4 (max x5 (max x6 (x7)))))))) : x0 ≤ m ∧ x1 ≤ m ∧ x2 ≤ m ∧ x3 ≤ m ∧ x4 ≤ m ∧ x5 ≤ m ∧ x6 ≤ m ∧ x7 ≤ m := by lia (splits := 100000)

theorem natsub_8 (a0 : Nat) (a1 : Nat) (a2 : Nat) (a3 : Nat) (a4 : Nat) (a5 : Nat) (a6 : Nat) (a7 : Nat) (b0 : Nat) (b1 : Nat) (b2 : Nat) (b3 : Nat) (b4 : Nat) (b5 : Nat) (b6 : Nat) (b7 : Nat)  : (a0 - b0) + (a1 - b1) + (a2 - b2) + (a3 - b3) + (a4 - b4) + (a5 - b5) + (a6 - b6) + (a7 - b7) ≤ a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 := by lia (splits := 100000)

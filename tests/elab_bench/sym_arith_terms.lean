/-!
Benchmark for the `arith` simproc of `Sym.simp` on normal forms of subterms: arithmetic arguments
of uninterpreted functions, nested atoms whose arguments are normalized, many normalized subterms
in one goal, and relations over `Rat` with numeral denominators.
-/

set_option sym.arith.maxTerms 1000
set_option sym.arith.maxDegree 1000

register_sym_simp arithSimp where
  pre  := arith >> control >> arrow_telescope
  post := ground

example (f : Int → Int) (a b c : Int) : f ((a + b - c)^6) = f ((c - b - a)^6) := by sym => simp arithSimp
example (f : Nat → Nat) (a b c : Nat) : f ((a + 2*b + c)^5) = f ((c + a + 2*b)^2 * (2*b + c + a)^3) := by sym => simp arithSimp
example (f : Int → Int → Int) (x y : Int) : f ((x + y)^4) ((x - y)^4) = f ((y + x)^2 * (x + y)^2) ((y - x)^4) := by sym => simp arithSimp
example (f g : Int → Int) (a b : Int) : f (g (a + b) * g (b + a) + 1) = f (g (b + a)^2 + 1) := by sym => simp arithSimp
example (f : Int → Int) (a b c : Int) : f (f (a + b + c) + f (c + b + a)) = f (2 * f (a + c + b)) := by sym => simp arithSimp

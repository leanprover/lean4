example (x y z : Rat) : (x / 2 + y / 3 ≤ z / 6) = (3 * x + 2 * y ≤ z) := by sym => simp arithSimp
example (x y z : Rat) : (x / 2 + y / 3 < z / 6 + x / 4) = (3 * x + 4 * y < 2 * z) := by sym => simp arithSimp
example (x y : Rat) : ((x / 3 + y / 5)^2 ≤ (x / 3 - y / 5)^2) = (4 * (x * y) ≤ 0) := by sym => simp arithSimp

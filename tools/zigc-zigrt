#!/usr/bin/env bash
set -euo pipefail

# Wrapper for compiling Lean-generated Zig code into an executable using the Zig runtime.
# Usage: zigc-zigrt <input.zig> [output-name]
#
# Links against libleanrt_zig.a (the in-tree Zig runtime) instead of the C++ runtime/stdlib.
# Requires libgmp and libuv to be discoverable by zig build-exe.

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILD_DIR="${BUILD_DIR:-$ROOT/build/release/stage1}"

INPUT="$1"
OUTPUT="${2:-$(basename "$INPUT" .zig)}"

ZIGRT_LIB="$BUILD_DIR/runtime/zig/zig-out/lib/libleanrt_zig.a"
if [[ ! -f "$ZIGRT_LIB" ]]; then
  echo "zigc-zigrt: $ZIGRT_LIB not found; run 'make -C \"$BUILD_DIR\" leanrt_zig'" >&2
  exit 1
fi

EXTRA_FLAGS=()
if [[ "$OSTYPE" == "darwin"* ]]; then
  EXTRA_FLAGS=(-L/opt/homebrew/lib -framework CoreFoundation)
fi

zig build-exe "$INPUT" -O Debug \
  -I "$BUILD_DIR/include" \
  "$ZIGRT_LIB" \
  -lgmp -luv -lpthread \
  "${EXTRA_FLAGS[@]}" \
  -femit-bin="$OUTPUT"

#!/usr/bin/env bash
set -euo pipefail

# Wrapper for compiling Lean-generated Zig code into an executable using the Zig runtime.
# Usage: zigc-zigrt <input.zig> [output-name]
#
# Links against libleanrt_zig.a (the in-tree Zig runtime) instead of the C++ runtime/stdlib.

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LEANC="${LEANC:-$ROOT/build/release/stage1/bin/leanc}"

if [[ ! -x "$LEANC" ]]; then
  echo "zigc-zigrt: leanc not found at $LEANC" >&2
  exit 1
fi

INPUT="$1"
OUTPUT="${2:-$(basename "$INPUT" .zig)}"

ZIGRT_LIB="$ROOT/build/release/stage1/runtime/zig/zig-out/lib/libleanrt_zig.a"
if [[ ! -f "$ZIGRT_LIB" ]]; then
  echo "zigc-zigrt: $ZIGRT_LIB not found; run 'make -C build/release/stage1/runtime/zig leanrt_zig'" >&2
  exit 1
fi

zig build-exe "$INPUT" -O Debug \
  -I "$ROOT/build/release/stage1/include" \
  -L "$ROOT/build/release/stage1/lib/lean" \
  "$ZIGRT_LIB" \
  -lgmp -luv -lpthread \
  -L/opt/homebrew/lib -framework CoreFoundation \
  -femit-bin="$OUTPUT"

module

import EmitZig.CLI

open System

namespace file_level_tests

private def mkTempDir : IO FilePath := do
  IO.FS.createTempDir

private unsafe def runEmit (fileName source : String) : IO String := do
  let dir ← mkTempDir
  let input := dir / fileName
  let output := dir / "out.zig"
  IO.FS.writeFile input source
  let rc ← EmitZig.emitzigMain [input.toString, "-o", output.toString]
  assert! rc == 0
  IO.FS.readFile output

private def assertContainsAll (text : String) (needles : List String) : IO Unit := do
  for needle in needles do
    assert! text.contains needle

public unsafe def runTests : IO Unit := do
  let headerOut ← runEmit "Header.lean" "def value : Nat := 1\n"
  assert! headerOut.startsWith "// generated by emitzig"
  assertContainsAll headerOut [
    "extern fn lean_ctor_set",
    "extern fn lean_unbox_uint64",
    "extern fn lean_apply_4",
    "extern fn lean_alloc_closure",
    "extern fn lean_closure_set",
    "extern fn lean_mk_string_unchecked",
    "extern fn lean_initialize_runtime_module",
    "extern fn lean_initialize_thread",
    "extern fn lean_io_mark_end_initialization",
    "extern fn lean_run_main"
  ]
  assertContainsAll headerOut [
    "inline fn lean_alloc_ctor(",
    "inline fn lean_inc(",
    "inline fn lean_dec(",
    "inline fn lean_box(",
    "inline fn lean_unbox_uint32(",
    "inline fn lean_unsigned_to_nat(",
    "inline fn lean_io_result_mk_ok("
  ]
  assert! !headerOut.contains "extern fn lean_alloc_ctor("
  assert! !headerOut.contains "extern fn lean_inc("
  assert! !headerOut.contains "extern fn lean_dec("
  assert! !headerOut.contains "extern fn lean_box("
  assert! !headerOut.contains "extern fn lean_unbox_uint32("
  assert! !headerOut.contains "extern fn lean_unsigned_to_nat("
  assert! !headerOut.contains "extern fn lean_io_result_mk_ok("

  let declOut ← runEmit "TwoFns.lean" "def first : Nat := 1\ndef second : Nat := first + 1\n"
  assertContainsAll declOut [
    "extern fn l_first",
    "extern fn l_second",
    "fn l_first__def",
    "fn l_second__def",
    "initialize_TwoFns"
  ]

  let withMain ← runEmit "WithMain.lean" "def main : IO Unit := pure ()\n"
  let withoutMain ← runEmit "WithoutMain.lean" "def helper : Nat := 1\n"
  assert! withMain.contains "pub fn main(argc: c_int, "
  assert! !withoutMain.contains "pub fn main(argc: c_int, "

  let erasedOut ← runEmit "PolyId.lean" <| String.intercalate "\n" [
    "def polyId.{u} {α : Type u} (x : α) := x",
    "def usePolyId (n : Nat) : Nat := polyId n"
  ]
  assert! erasedOut.contains "extern fn l_polyId(arg_v___uniq_2_: LeanObj) callconv(.c) LeanObj;"
  assert! !erasedOut.contains "extern fn l_polyId(arg_v___uniq_1_: LeanObj, arg_v___uniq_2_: LeanObj) callconv(.c) LeanObj;"
  assert! !erasedOut.contains " = l_polyId(lean_box(@as(usize, 0)), "
  pure ()
